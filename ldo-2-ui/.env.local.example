# Backend FastAPI URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Application
NEXT_PUBLIC_APP_NAME=LDO-2
NEXT_PUBLIC_APP_VERSION=2.0.0

# Auth
NEXT_PUBLIC_AUTH_TOKEN_KEY=ldo_token

# Feature Flags
NEXT_PUBLIC_ENABLE_OCR=true
NEXT_PUBLIC_ENABLE_DEDUPLICATION=true
NEXT_PUBLIC_ENABLE_AUDIT=true

# File Upload
NEXT_PUBLIC_MAX_FILE_SIZE_MB=50
NEXT_PUBLIC_ALLOWED_FILE_TYPES=pdf,docx,dwg,png,jpg,jpeg,tiff
